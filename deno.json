{
  "lock": true,
  "nodeModulesDir": "none",
  "imports": {
    "@hono/hono": "jsr:@hono/hono@4.13.19",
    "@hono/hono/": "jsr:/@hono/hono@4.13.19/",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing/": "jsr:/@std/testing@1.0.21/",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/cli/": "jsr:/@std/cli@1.0.32/",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@std/encoding/": "jsr:/@std/encoding@1.0.11/",
    "postgres": "npm:postgres@4.1.1",
    "zod": "npm:zod@4.6.7",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.4.0",
    "@modelcontextprotocol/server/": "npm:/@modelcontextprotocol/server@2.4.0/",
    "@hilvana/sdk/": "./sdk/ts/",
    "@hilvana/connectors/": "./telar/connectors/",
    "@hilvana/lab/": "./lab/src/",
    "@hilvana/agent/": "./agent/src/",
    "@hilvana/telar/": "./telar/src/"
  },
  "tasks": {
    "telar": "deno run --allow-net --allow-read=telar/config,agent/config,lab/config --allow-env telar/src/main.ts",
    "worker": "deno run --allow-net --allow-read=telar/config,agent/config,lab/config --allow-env telar/src/worker_main.ts",
    "test": "deno test --allow-read --allow-env --allow-net=127.0.0.1,localhost --allow-write=lab/generated,coverage --coverage=coverage --ignore=telar/tests/integration",
    "test:integration": "deno test --allow-read --allow-env --allow-net --allow-write=coverage --coverage=coverage telar/tests/integration",
    "coverage": "deno coverage coverage --exclude=tests/ --exclude=fixtures/",
    "check": "deno check telar/src/main.ts telar/src/worker_main.ts cli/main.ts skill/mcp/server.ts lab/src/cli.ts agent/evals/run.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "eval": "deno run --allow-read=agent --allow-env --allow-net agent/evals/run.ts",
    "lab": "deno run --allow-read --allow-write=lab,sdk --allow-env --allow-net lab/src/cli.ts",
    "cli": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run cli/main.ts",
    "compile:cli": "deno compile --allow-read --allow-write --allow-env --allow-net --allow-run --include=supabase/migrations --target x86_64-unknown-linux-gnu --output dist/hilvana cli/main.ts",
    "mcp": "deno run --allow-env --allow-net skill/mcp/server.ts",
    "demo:seed": "deno run --allow-read --allow-env --allow-net scripts/demo_seed.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true,
    "exclude": ["app/", "docs/", "supabase/", "assets/", "**/*.md", "lab/contracts/", "lab/samples/", "sdk/dart/"]
  },
  "lint": {
    "exclude": ["app/", "sdk/dart/", "coverage/", "dist/"]
  },
  "test": {
    "exclude": ["app/", "coverage/", "dist/"]
  },
  "exclude": ["app/build/", "app/.dart_tool/", "coverage/", "dist/"]
}
