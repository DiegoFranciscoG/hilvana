# Copia este archivo a .env o ejecuta `deno task cli init`, que lo crea y genera los secretos.
# .env NUNCA se sube a GitHub. Sin valores por defecto para secretos: si falta uno, el servicio no arranca.
# Lo que interpola docker compose lleva el prefijo HILVANA_: compose da prioridad al entorno de la shell
# sobre .env, y nombres genéricos como JWT_SECRET o POSTGRES_PASSWORD suelen existir ya en el equipo.

# --- Base de datos (Supabase autoalojado en docker compose)
HILVANA_DB_PASSWORD=

# --- Auth de Supabase: secreto HS256 de 32 bytes o más; las claves anon y service_role son JWT firmados con él
HILVANA_JWT_SECRET=
HILVANA_ANON_KEY=
HILVANA_SERVICE_ROLE_KEY=

# --- Realtime de Supabase
REALTIME_DB_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# --- Telar (pasarela y trabajador) en docker compose
TELAR_DB_PASSWORD=
TELAR_DRAIN_TOKEN=
HILVANA_LOG_LEVEL=info
HILVANA_LAB_CAPTURE=on

# --- Usuario de demo (demo@hilvana.test), solo para el entorno local
HILVANA_DEMO_PASSWORD=

# --- Telar fuera de docker compose (Supabase CLI o nube): el Telar lee estos nombres tal cual
TELAR_DB_HOST=
TELAR_DB_PORT=5432
TELAR_DB_SSL=
TELAR_PORT=8787
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
TELAR_ALLOWED_ORIGINS=
TELAR_PUBLIC_URL=
LOG_LEVEL=info
LAB_CAPTURE=on

# --- Push opcional con Firebase Cloud Messaging (cuenta de servicio en base64)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_B64=

# --- Evaluación opcional del agente contra un modelo real compatible con chat completions
HILVANA_EVAL_BASE_URL=
HILVANA_EVAL_MODEL=
HILVANA_EVAL_API_KEY=
